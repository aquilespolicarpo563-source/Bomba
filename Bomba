-- ============================================
-- DROP BOMB NOS PÉS (Laser para baixo - Sem Bug)
-- ============================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local ultimoUso = 0
local tempoCooldown = 19 -- Cooldown da bomba

-- ============================================
-- BOTÃO FLUTUANTE
-- ============================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 65, 0, 65)
btn.Position = UDim2.new(0, 50, 0, 150)
btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
btn.BackgroundTransparency = 0.1
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 30
btn.Text = "💣"
btn.Parent = ScreenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = btn

-- Arrastar botão
local dragging, dragStart, startPos, isMoved
btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        isMoved = false
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then 
                dragging = false 
                if not isMoved then btn.MouseButton1Click:Fire() end
            end
        end)
    end
end)

btn.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        if (input.Position - dragStart).Magnitude > 10 then isMoved = true end
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Atualiza o botão com o tempo restante
RunService.Heartbeat:Connect(function()
    local tempoPassado = tick() - ultimoUso
    if tempoPassado < tempoCooldown then
        local restante = math.ceil(tempoCooldown - tempoPassado)
        btn.Text = tostring(restante) .. "s"
        btn.TextSize = 20
        btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    else
        btn.Text = "💣"
        btn.TextSize = 30
        btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ============================================
-- LÓGICA DO ARREMESSO (Laser pra baixo)
-- ============================================
btn.MouseButton1Click:Connect(function()
    if tick() - ultimoUso < tempoCooldown then return end -- Ainda no cooldown

    local char = LocalPlayer.Character
    if not char then return end

    -- Procura a bomba na mão
    local bombTool = nil
    for _, tool in ipairs(char:GetChildren()) do
        local nome = string.lower(tool.Name)
        if tool:IsA("Tool") and (nome:find("bomb") or nome:find("fake")) then
            bombTool = tool
            break
        end
    end

    if not bombTool then
        game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Aviso", Text = "Equipe a bomba primeiro!", Duration = 2})
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Procura o RemoteEvent
    local remoteEvent = nil
    for _, desc in ipairs(bombTool:GetDescendants()) do
        if desc:IsA("RemoteEvent") then remoteEvent = desc break end
    end

    if remoteEvent then
        ultimoUso = tick()
        
        -- LASER PRA BAIXO: Acha o chão exato entre as pernas
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char} -- Ignora o próprio boneco
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        -- Traça um raio do peito até 10 studs pra baixo
        local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -10, 0), rayParams)
        
        local dropPos
        if rayResult then
            dropPos = rayResult.Position -- Pega a posição exata do chão
        else
            dropPos = hrp.Position - Vector3.new(0, 3.5, 0) -- Reserva (se estiver no ar)
        end
        
        -- Dispara a bomba no chão
        remoteEvent:FireServer(CFrame.new(dropPos), 50)
        
        -- Efeito visual (pisca branco)
        btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end
end)
